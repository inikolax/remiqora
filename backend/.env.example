# Copy this file to .env and adjust the paths for your machine.

# Paths to the two AI model repos this app orchestrates.
ACE_STEP_DIR=E:\AI\ACE\ACE-Step-1.5
YUE2_DIR=E:\AI\YuE2-3B

# Separate uv-managed venv/project for Demucs (stem separation).
# setup_models.ps1 sets this up automatically in external/Demucs; only
# change it if you'd rather manage that uv project somewhere else yourself
# (same recipe: "uv add demucs numpy", plus routing "torch" at PyTorch's
# cu128 wheel index so it's a CUDA build, not a CPU-only one - see
# setup_models.ps1 for the exact pyproject.toml). htdemucs model weights
# auto-download on first use (needs internet access once).
DEMUCS_DIR=E:\AI\Demucs

# ffmpeg bin dir (used by ACE-Step's process launch and by our own
# non-WAV-upload transcoding for YuE2). setup_models.ps1 fills this in
# automatically by locating the ffmpeg winget install from
# setup_prereqs.bat; only change it if ffmpeg lives somewhere else on your
# machine. The CUDA toolkit bin dir below is needed on PATH for YuE2's
# audiocpp_server.exe to find its CUDA DLLs, and is not auto-filled.
FFMPEG_BIN_DIR=E:\AI\ACE\tools\ffmpeg-shared\ffmpeg-master-latest-win64-gpl-shared\bin
CUDA_BIN_DIR=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.4\bin

# Optional internal model API ports. Useful when another local service already
# occupies Remiqora defaults. These APIs remain loopback-only.
# ACE_STEP_API_PORT=8001
# YUE2_SERVER_PORT=8080

# Optional Linux/headless settings. Leave device values blank to let each
# backend choose automatically; set them when dedicating GPUs per engine.
# UV_BIN=/absolute/path/to/uv
# CUDA_LIB_DIR=/usr/local/cuda/lib64
# ACE_STEP_DEVICE=0
# YUE2_SERVER_HOST=127.0.0.1
# YUE2_DEVICE=1
